{
    "name": "karsawave/palakar",
    "description": "Palakar Framework: a simple and secure PHP 8.2+ framework, fork of Panada Framework 1.1.1",
    "keywords": [
        "php",
        "palakar",
        "framework",
        "simple",
        "kiss",
        "panada"
    ],
    "homepage": "https://github.com/karsawave/palakar",
    "type": "project",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "KarsaWave",
            "homepage": "https://github.com/karsawave",
            "role": "Maintainer of the Palakar fork"
        },
        {
            "name": "Iskandar Soesman",
            "email": "k4ndar@yahoo.com",
            "role": "Original author of Panada Framework"
        }
    ],
    "support": {
        "issues": "https://github.com/karsawave/palakar/issues",
        "source": "https://github.com/karsawave/palakar"
    },
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "filp/whoops": "^2.16",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "filp/whoops": "Interactive error page while 'debug' is true",
        "ext-sodium": "Needed by Resources\\Encryption and the encrypted cookie session driver"
    },
    "autoload": {
        "psr-4": {
            "Resources\\": "panada/Resources/",
            "Drivers\\": "panada/Drivers/"
        },
        "classmap": [
            "panada/Gear.php"
        ],
        "files": [
            "panada/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "serve": "php -S localhost:8000 -t public public/index.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
