{
    "name": "panada/panada",
    "description": "A PHP Framework for those who love simplicity and performance at the same time",
    "keywords": [
        "php",
        "panada",
        "framework",
        "simple",
        "kiss"
    ],
    "homepage": "http://panadaframework.com/",
    "type": "project",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Iskandar Soesman",
            "email": "k4ndar@yahoo.com"
        }
    ],
    "support": {
        "issues": "https://github.com/panada/Panada/issues",
        "source": "https://github.com/panada/Panada/"
    },
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "filp/whoops": "^2.16",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "filp/whoops": "Interactive error page while 'debug' is true",
        "ext-sodium": "Needed by Resources\\Encryption and the encrypted cookie session driver"
    },
    "autoload": {
        "psr-4": {
            "Resources\\": "panada/Resources/",
            "Drivers\\": "panada/Drivers/"
        },
        "classmap": [
            "panada/Gear.php"
        ],
        "files": [
            "panada/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8000 -t public public/index.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
